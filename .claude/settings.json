{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "make lint --silent || true" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(./.env)", "Bash(rm -rf /*)", "Bash(pip install ultralytics*)"]
  }
}
