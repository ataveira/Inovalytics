# Copie para .env (fora do Git) e preencha. Nunca commite valores reais.
# Todas as variáveis abaixo são lidas pelo docker-compose.yml.
# Variáveis sem valor obrigatório têm padrão no compose (indicado ao lado).

# PostgreSQL (padrão de usuário e banco: inovalytics)
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# Armazenamento S3-compatível (SeaweedFS no compose; acessado via boto3)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# padrão: inovalytics
S3_BUCKET=

# Porta da API publicada no host (padrão: 8000)
API_PORT=

# Endereço de bind da API no host (padrão: 127.0.0.1; use 0.0.0.0 para expor à rede)
API_BIND=

# Startup da API: prazo total (s, padrão 30) e número de tentativas (padrão 5) para
# verificar/criar o bucket S3. Opcionais (descomente para alterar); valores não positivos
# são rejeitados.
# S3_STARTUP_TIMEOUT=30
# S3_STARTUP_RETRIES=5

# Limites de upload de imagens (F1-05). Opcionais; valores não positivos são rejeitados.
# Padrões: 20 MiB por arquivo, 20 arquivos por requisição, 16384 px por lado, 100 000 000 px.
# UPLOAD_MAX_BYTES=20971520
# UPLOAD_MAX_FILES=20
# UPLOAD_MAX_DIMENSION=16384
# UPLOAD_MAX_PIXELS=100000000

# Leitura (s) do cliente S3 usado no upload; connect fixo em 3 s. Padrão 60; deve ser positivo.
# S3_UPLOAD_READ_TIMEOUT=60

# Limites da importação COCO (F1-06c; padrões são proposta, ver ADR-008). Opcionais; valores não
# positivos são rejeitados. Padrões: 16 MiB de JSON, 50 000 imagens, 300 000 anotações,
# 1 000 categorias, profundidade 12 e 100 erros no relatório.
# IMPORT_MAX_JSON_BYTES=16777216
# IMPORT_MAX_IMAGES=50000
# IMPORT_MAX_ANNOTATIONS=300000
# IMPORT_MAX_CATEGORIES=1000
# IMPORT_MAX_DEPTH=12
# IMPORT_MAX_ERRORS=100

# Importação de rótulos no formato YOLO (txt) (F1-07d; ver ADR-009). Vale também para esta rota
# tudo o que está acima; este limite é do texto de data_yaml (padrão: 64 KiB). Opcional.
# IMPORT_MAX_YAML_BYTES=65536

# Importação Pascal VOC (XML) (F1-08d; ver ADR-010). Vale também tudo o que está acima (corpo JSON,
# arquivos, objetos, classes, erros); este limite é do tamanho de cada XML, em bytes UTF-8
# (padrão: 256 KiB). Opcional. Os demais limites do leitor (profundidade 16, 20 000 elementos,
# 32 atributos, 600 000 marcações no total) são constantes, não variáveis de ambiente.
# IMPORT_MAX_XML_BYTES=262144
